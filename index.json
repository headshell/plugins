          "sha256": "36e0b32a75b74f9a3b2705171f8abe569fddb3cd714a11ca8ee169d67b08af3d"
        }
      ]
    },
    {
      "manifest": {
        "api": 7,
        "artwork": true,
        "capabilities": [
          "search"
        ],
        "description": "Finds music videos on YouTube (InnerTube, YouTube Music's video search) and hands them to the app's official YouTube player (the IFrame embed on youtube-nocookie.com). Nothing is downloaded and no stream is resolved: YouTube plays the video itself, with its own ads and its own counting, and the player stays on screen while it plays — YouTube's rules (D-086). No yt-dlp. The cover is the video's own thumbnail from `i.ytimg.com`. The official video is taken over the artist's audio upload: YouTube's own search, at the same address, gives the uploads' titles; an upload that is only the song's sound (audio, lyrics, a visualizer, an art track) is not offered as its video (D-096).",
        "display_name": "YouTube",
        "links": [],
        "lyrics": false,
        "main": "main.js",
        "name": "youtube",
        "permissions": {
          "net": [
            "music.youtube.com",
            "i.ytimg.com"
          ]
        },
        "related": false,
        "version": "0.3.0",
        "video": true
      },
      "files": [
        {
          "path": "plugin.json",
          "url": "https://raw.githubusercontent.com/headshell/plugins/refs/tags/youtube-0.3.0/youtube/plugin.json",
          "sha256": "dace47d3957edfbb28d275d1e51a977c59383a4c2348c7cf21dfa517f22becbf"
        },
        {
          "path": "main.js",
          "url": "https://raw.githubusercontent.com/headshell/plugins/refs/tags/youtube-0.3.0/youtube/main.js",
          "sha256": "4986f0f83b5ab8f72fce840859eca46e71fbdface792b12c673ce1f20c15e67e"
        }
      ]
    },
    {
      "manifest": {
        "api": 7,
        "artwork": true,
        "capabilities": [
          "search",
          "stream"
        ],
        "description": "Searches YouTube Music (InnerTube) and plays its m4a stream: the address comes from InnerTube's own player endpoint in a fraction of a second (the fast path, headshell D-088), and from yt-dlp when that fails. Gives the song's album art from InnerTube (`yt3`/`lh3.googleusercontent.com`), its lyrics — timed line by line when YouTube Music has the timing — its radio, the songs like it, and the song or video at a YouTube Music or YouTube link — one that isn't on YouTube Music too. The engine installs yt-dlp: it downloads this platform's self-contained binary and verifies its hash (D-069); no Python is needed on the system. If a `cookies` secret is given, it's passed to yt-dlp as a cookie file — YouTube puts up a bot wall for data centre addresses (D-061). NOTE — yt-dlp isn't a script the engine jails but a separate program: its network traffic isn't limited by this plugin's permission list. There's no single-file release for Linux armv7 (`linux-arm`), and none at all for 32-bit Linux.",
        "display_name": "YouTube Music",
        "links": [
          "https://music.youtube.com/watch?v={id}",
          "https://www.youtube.com/watch?v={id}",
          "https://youtu.be/{id}"
        ],
        "lyrics": true,
        "main": "main.js",
        "name": "ytmusic",
        "permissions": {
          "net": [
            "music.youtube.com",
            "*.googlevideo.com",
            "yt3.googleusercontent.com",
            "lh3.googleusercontent.com"
          ]
        },
