        "description": "Searches and plays SoundCloud. Takes the client_id from the secret store, and otherwise discovers it itself. Gives the track's cover. `*.sndcdn.com`: the web client's JS assets (a-v2), the audio stream (cf-media) and the covers (i1) are under this domain.",
        "display_name": "SoundCloud",
        "lyrics": false,
        "main": "main.js",
        "name": "soundcloud",
        "permissions": {
          "net": [
            "soundcloud.com",
            "api-v2.soundcloud.com",
            "*.sndcdn.com"
          ]
        },
        "version": "0.4.0"
      },
      "files": [
