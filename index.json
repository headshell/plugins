        "lyrics": false,
        "main": "main.js",
        "name": "soundcloud",
        "permissions": {
          "net": [
            "soundcloud.com",
            "api-v2.soundcloud.com",
            "*.sndcdn.com"
          ]
        },
        "related": true,
        "version": "0.6.0",
        "video": false
      },
