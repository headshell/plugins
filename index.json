    {
      "manifest": {
        "api": 2,
        "capabilities": [
          "search",
          "stream"
        ],
        "description": "Searches YouTube Music (InnerTube) and plays the m4a stream it resolves with yt-dlp. The engine installs yt-dlp: it downloads this platform's self-contained binary and verifies its hash (D-069); no Python is needed on the system. If a `cookies` secret is given, it's passed to yt-dlp as a cookie file — YouTube puts up a bot wall for data centre addresses (D-061). NOTE — yt-dlp isn't a script the engine jails but a separate program: its network traffic isn't limited by this plugin's permission list. There's no single-file release for Linux armv7 (`linux-arm`), and none at all for 32-bit Linux.",
        "display_name": "YouTube Music",
        "main": "main.js",
        "name": "ytmusic",
