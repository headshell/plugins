        "lyrics": false,
        "main": "main.js",
        "name": "soundcloud",
        "permissions": {
          "net": [
            "soundcloud.com",
            "api-v2.soundcloud.com",
            "*.sndcdn.com"
          ]
        },
        "version": "0.5.0",
        "video": false
      },
